# CHIZ Booth — optional config file.
# Copy to booth.toml and edit. Every key is optional; env vars CHIZ_* win.
# On the Pi kiosk, set  fullscreen = true .

[booth]
screen_w = 480
screen_h = 800
fullscreen = false
fps = 60
scanlines = false        # flat «کمیک قورمه» look
scanline_strength = 32

attract_timeout_s = 60

sound = true
sfx_volume = 0.8

led_count = 8
led_gpio = 18
led_brightness = 160
led_enabled = true

admin_host = "0.0.0.0"
admin_port = 8000
admin_pin = "1390"

hostname = "chiz"
currency = "تومان"

payment_methods = ["qr", "card"]   # what the buyer can pick (button 1 / 2)
payment_provider = "manual"   # "free" = every method auto-approves (testing)
zarinpal_merchant_id = ""
zarinpal_sandbox = true
payment_poll_seconds = 3.0
payment_timeout_s = 180

order_ttl_minutes = 30

# showcase door: solenoid lock via relay + reed-switch door sensor.
# After payment the lock is released for the operator; the sensor starts
# the countdown when the door opens; closing the door ends the hand-over.
lock_enabled = true
lock_gpio = 17
lock_active_high = true
door_open_s = 20             # countdown once the door is open, for 1 item
door_extra_per_item_s = 5    # + 5 s for every extra item (2 items = 25 s)
door_warn_s = 5              # last seconds: beep-beep, booth dims, red lights on
door_wait_s = 60      # unlocked but never opened → lock again

door_sensor_enabled = true
door_sensor_gpio = 27
door_open_when_high = true   # reed closed (door shut) pulls the pin low

# booth lighting on two MOSFETs: 1 = main light (PWM), 2 = red warning lights
lights_enabled = true
booth_light_gpio = 12
warn_light_gpio = 13
booth_light_dim = 0.15       # main light level during the warning
booth_light_level = 0.85     # while shopping (the add-to-cart blip goes to 100 %)

# lamp inside the red confirm button (the only lit button)
red_light_enabled = true
red_light_gpio = 22

# USB encoder keymap: key names ("1", "return", "f5") or raw key codes.
# 8 buttons: slot1..slot6 beside the cards — 1, 3, 5 on the LEFT of the
# screen (top to bottom), 2, 4, 6 on the RIGHT — plus red confirm and cancel.
[booth.keymap]
slot1 = "1"
slot2 = "2"
slot3 = "3"
slot4 = "4"
slot5 = "5"
slot6 = "6"
confirm = "return"   # big red button (lit)
cancel = "escape"    # «انصراف»
door_sim = "d"       # laptop only: open/close the showcase door
