# CHIZ Booth — admin panel service
# Install:  sudo cp deploy/chiz-admin.service /etc/systemd/system/
#           sudo systemctl enable --now chiz-admin
[Unit]
Description=CHIZ Booth Admin Panel (FastAPI on :8000)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/salesbooth
ExecStart=/home/pi/salesbooth/.venv/bin/python -m uvicorn admin.app:app \
          --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
