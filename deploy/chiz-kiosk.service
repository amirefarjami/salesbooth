# CHIZ Booth — kiosk service
# Install:  sudo cp deploy/chiz-kiosk.service /etc/systemd/system/
#           sudo systemctl enable --now chiz-kiosk
[Unit]
Description=CHIZ Booth Kiosk (Pygame UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# draw straight to the display without X/Wayland (SDL2: kmsdrm; the old
# SDL1 "fbcon" driver does not exist in pygame 2 and the UI never opened)
SupplementaryGroups=video render input audio gpio
WorkingDirectory=/home/pi/salesbooth
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=alsa
Environment=CHIZ_FULLSCREEN=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/salesbooth/.venv/bin/python -m kiosk.app
Restart=always
RestartSec=3
# watchdog: service must call sd_notify WATCHDOG=1; simple restart-on-exit
# plus kernel OOM handling is enough for the booth.
WatchdogSec=0

[Install]
WantedBy=multi-user.target
